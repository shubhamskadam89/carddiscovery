# Copy to .env and fill in. .env is git-ignored and docker-ignored: keep secrets only there.

# The address people open. On EC2: https://<your-domain>. Locally: http://127.0.0.1:8080 with HTTP_PORT=8080.
# Google sign-in returns to <CD_PUBLIC_URL>/oauth/callback: add that URL to the OAuth client in Google Cloud.
CD_PUBLIC_URL=http://127.0.0.1:8080
HTTP_PORT=8080

POSTGRES_USER=cd
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Google OAuth client JSON on the host (mounted read-only into the backend)
GOOGLE_CLIENT_FILE=./credentials.json

CD_SCAN_MODE=monthly

# Gmail addresses of the team (comma-separated): only they see the developer panel and can call /api/dev/*
CD_ADMIN_EMAILS=

# Team report inbox (optional): users' forwarded reports are read from this connected Gmail
CD_REPORT_INBOX=

# Shadow Claude Haiku fallback: off | cli | api, and the account ids allowed to use it
CD_LLM_FALLBACK=off
CD_LLM_ACCOUNTS=
# cli: a token from `claude setup-token` on your laptop.  api: an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Set to 0 to build without Node and the Claude CLI (smaller image)
WITH_CLAUDE_CLI=1
